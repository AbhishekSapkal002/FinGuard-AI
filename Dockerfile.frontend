# Stage 1: Build the React Application
FROM node:20-alpine as builder

WORKDIR /app

# Copy the package.json and install dependencies
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps

# Copy the rest of the frontend source code
COPY frontend/ ./

# Create the optimized production build
RUN npm run build

# Stage 2: Serve the App using Nginx for maximum performance
FROM nginx:alpine

# Copy custom Nginx configuration to reverse proxy the backend predictions
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy the build artifact from our builder stage to Nginx's default public folder
COPY --from=builder /app/build /usr/share/nginx/html

# Expose default HTTP port
EXPOSE 80

# Keep Nginx running in the foreground
CMD ["nginx", "-g", "daemon off;"]
